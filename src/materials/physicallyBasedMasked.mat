material {
    name : PhysicallyBasedMasked,
    blending : masked,
    shadingModel : lit,
    doubleSided : true,
    flipUV : false,
    parameters : [
        {
            type : float4,
            name : baseColor
        },
        {
            type : float,
            name : metallic
        },
        {
            type : float,
            name : roughness
        },
        {
            type : float3,
            name : emissive
        },
        {
            type : sampler2d,
            name : emissiveMap
        },
        {
            type : bool,
            name : hasEmissiveMap
        },
        {
            type : float,
            name : opacity
        },
        {
            type : sampler2d,
            name : baseColorMap
        },
        {
            type : bool,
            name : hasBaseColorMap
        },
        {
            type : sampler2d,
            name : metallicRoughnessMap
        },
        {
            type : bool,
            name : hasMetallicRoughnessMap
        },
        {
            type : sampler2d,
            name : normalMap
        },
        {
            type : bool,
            name : hasNormalMap
        },
        {
            type : float,
            name : normalScale
        },
        {
            type : sampler2d,
            name : occlusionMap
        },
        {
            type : bool,
            name : hasOcclusionMap
        },
        {
            type : float,
            name : occlusionStrength
        },
        {
            type : int,
            name : baseColorUV
        },
        {
            type : int,
            name : metallicRoughnessUV
        },
        {
            type : int,
            name : normalUV
        },
        {
            type : int,
            name : occlusionUV
        },
        {
            type : int,
            name : emissiveUV
        },
        {
            type : mat3,
            name : baseColorUvMatrix
        },
        {
            type : mat3,
            name : metallicRoughnessUvMatrix
        },
        {
            type : mat3,
            name : normalUvMatrix
        },
        {
            type : mat3,
            name : occlusionUvMatrix
        },
        {
            type : mat3,
            name : emissiveUvMatrix
        },
        {
            type : bool,
            name : useAttribute0ForMetallic
        },
        {
            type : bool,
            name : useAttribute1ForRoughness
        }
    ],
    requires : [
        color,
        uv0,
        uv1
    ]
}

fragment {
    vec2 uvApply(int uvIndex, highp mat3 m) {
        vec2 uv = (uvIndex == 1) ? getUV1() : getUV0();
        return (vec3(uv, 1.0) * m).xy;
    }

    void material(inout MaterialInputs material) {
        if (materialParams.hasNormalMap) {
            vec2 nUv = uvApply(materialParams.normalUV, materialParams.normalUvMatrix);
            vec3 n = texture(materialParams_normalMap, nUv).xyz * 2.0 - 1.0;
            n.xy *= materialParams.normalScale;
            material.normal = n;
        }
        prepareMaterial(material);

        float4 color = materialParams.baseColor * getColor();
        if (materialParams.hasBaseColorMap) {
            vec2 bUv = uvApply(materialParams.baseColorUV, materialParams.baseColorUvMatrix);
            color *= texture(materialParams_baseColorMap, bUv);
        }
        color.a *= materialParams.opacity;
        material.baseColor = color;

        float m = materialParams.metallic;
        if (materialParams.useAttribute0ForMetallic) {
            m = getUV0().x;
        }
        float r = materialParams.roughness;
        if (materialParams.useAttribute1ForRoughness) {
            r = getUV1().x;
        }
        if (materialParams.hasMetallicRoughnessMap) {
            vec2 ormUv = uvApply(materialParams.metallicRoughnessUV,
                    materialParams.metallicRoughnessUvMatrix);
            vec4 orm = texture(materialParams_metallicRoughnessMap, ormUv);
            r *= orm.g;
            m *= orm.b;
        }
        material.metallic = m;
        material.roughness = r;

        vec3 emissive = materialParams.emissive;
        if (materialParams.hasEmissiveMap) {
            vec2 eUv = uvApply(materialParams.emissiveUV, materialParams.emissiveUvMatrix);
            emissive *= texture(materialParams_emissiveMap, eUv).rgb;
        }
        material.emissive = vec4(emissive, 0.0);

        float ao = 1.0;
        if (materialParams.hasOcclusionMap) {
            vec2 oUv = uvApply(materialParams.occlusionUV, materialParams.occlusionUvMatrix);
            ao = texture(materialParams_occlusionMap, oUv).r;
        }
        material.ambientOcclusion =
            1.0 + materialParams.occlusionStrength * (ao - 1.0);
    }
}
